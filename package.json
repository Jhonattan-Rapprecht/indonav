{
  "name": "indonav",
  "version": "1.0.0",
  "description": "Express + MySQL navigation app with map overlays, custom markers, and AR objects.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i ./styles/dashboard.css -o ./public/css/style.css --minify",
    "build:vendor": "node scripts/build-vendor.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "predev": "npm run build",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "express",
    "mysql",
    "leaflet",
    "navigation",
    "ar"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mysql2": "^3.11.3",
    "three": "0.168.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0",
    "nodemon": "^3.1.7"
  }
}
